pragma Singleton

import QtQuick
import Quickshell
import qs.core
import qs.theme

// UI sounds. Built-in sounds are generated by scripts/gen-sounds.py into
// assets/sounds/<style>/<event>.wav.
//
// Played with pw-play in a short-lived process: ~10 ms CPU and ~30 ms latency
// per sound, nothing at all in between. (QtMultimedia's SoundEffect would add
// ~86 MiB to the shell for its FFmpeg backend, measured; not worth it.)
// Frequent sounds (typing, slider ticks) are rate limited.
//
// Events (config key -> sound files):
//   notification  notification            open / close  open, close
//   click         click                   toggle        toggle-on, toggle-off
//   slide         slide-0..7 (pitch)      typing        typing-0..2
//   volume        volume                  edit          edit-enter, edit-exit
//   snap          snap
Singleton {
    id: root

    readonly property list<string> events: ["notification", "open", "close", "click", "toggle", "slide", "typing", "volume", "edit", "snap"]
    readonly property list<string> builtIn: ["glass", "soft", "minimal", "bubble", "wood", "pulse", "retro", "bell", "mechanical", "scifi", "air"]
    readonly property string dir: Quickshell.shellDir + "/assets/sounds"
    readonly property string systemNotification: "/usr/share/sounds/freedesktop/stereo/message-new-instant.oga"
    readonly property int slideSteps: 8

    // Master switch. Low-power mode silences everything.
    readonly property bool enabled: Config.ready && Config.sounds.enabled
    readonly property real volume: Math.max(0, Math.min(1, Config.sounds.volume))

    function isOn(event: string): bool {
        if (!enabled || Theme.lowPower)
            return false;
        if (event === "notification")
            return Config.notifications.sound;
        return Config.sounds.on[event] === true;
    }

    function styleOf(event: string): string {
        const s = Config.sounds.style[event] ?? "glass";
        return typeof s === "string" && s !== "" ? s : "glass";
    }

    // The style every event shares ("" if they differ). The notification
    // sound is left out: it's usually "system".
    function commonStyle(): string {
        let common = "";
        for (let i = 0; i < events.length; i++) {
            if (events[i] === "notification")
                continue;
            const s = styleOf(events[i]);
            if (common === "")
                common = s;
            else if (s !== common)
                return "";
        }
        return common;
    }

    // Sets every event to `style` (Settings "Style for everything", IPC).
    // A "system" notification sound is kept.
    function setStyleAll(style: string): void {
        for (const e of events)
            if (e !== "notification" || Config.sounds.style.notification !== "system")
                Config.sounds.style[e] = style;
    }

    readonly property list<string> extensions: ["wav", "ogg", "oga", "opus", "flac", "mp3"]
    // The custom file for an event, or "" if it's not an absolute path to a
    // sound file. Whether it exists is checked when it plays (see play()).
    function customFile(event: string): string {
        const c = Config.sounds.custom;
        const p = c && typeof c[event] === "string" ? c[event].trim() : "";
        return isSoundPath(p) ? p : "";
    }
    function isSoundPath(p: string): bool {
        return p.startsWith("/") && extensions.indexOf(p.split(".").pop().toLowerCase()) !== -1;
    }
    function setCustom(event: string, path: string): void {
        const c = Object.assign({}, Config.sounds.custom || {});
        c[event] = path;
        Config.sounds.custom = c;
    }

    // The built-in file for `event` in `style` (variant = file name suffix).
    function builtInFile(style: string, file: string): string {
        if (builtIn.indexOf(style) === -1)
            style = "glass";
        return dir + "/" + style + "/" + file + ".wav";
    }

    // Plays `file` (a name like "toggle-on") for `event`, honouring the
    // event's style: built-in, system or a custom file. `force` skips the
    // on/off checks (preview button in Settings).
    function play(event: string, file: string, force: bool): void {
        if (!force && !isOn(event))
            return;
        cancelClick();
        const style = styleOf(event);
        let path, fallback = "";
        if (style === "custom") {
            // Custom file: falls back to the built-in sound if it isn't a
            // usable path, or if pw-play can't open it (missing, unreadable,
            // unsupported format).
            const custom = customFile(event);
            if (custom === "") {
                path = builtInFile("glass", file);
            } else {
                path = custom;
                fallback = builtInFile("glass", file);
            }
        } else if (style === "system" && event === "notification") {
            path = systemNotification;
            fallback = builtInFile("glass", file);
        } else {
            path = builtInFile(style, file);
        }
        exec(path, fallback);
    }

    function exec(path: string, fallback: string): void {
        const opts = ["--latency", "10ms", "--media-role", "Notification", "--volume", volume.toFixed(2)];
        if (fallback === "")
            Quickshell.execDetached(["pw-play"].concat(opts, [path]));
        else
            Quickshell.execDetached(["sh", "-c", 'p=$1; f=$2; shift 2; pw-play "$@" "$p" 2>/dev/null || exec pw-play "$@" "$f"',
                                     "sh", path, fallback].concat(opts));
    }

    // ---- Event helpers (call these from components) -------------------------

    // Click: deferred by a moment and dropped if the click caused another
    // sound (a button that opens a panel plays only "open").
    function click(): void {
        if (isOn("click"))
            clickTimer.restart();
    }
    function cancelClick(): void {
        clickTimer.stop();
    }
    Timer {
        id: clickTimer
        interval: 30
        onTriggered: root.play("click", "click", false)
    }

    function toggled(on: bool): void {
        play("toggle", on ? "toggle-on" : "toggle-off", false);
    }

    // Slider tick at `ratio` (0–1): its pitch rises with the value.
    // At most one per 45 ms, so a fast drag doesn't machine-gun.
    property real lastSlide: 0
    function slide(ratio: real): void {
        const now = Date.now();
        if (!isOn("slide") || now - lastSlide < 45)
            return;
        lastSlide = now;
        const k = Math.round(Math.max(0, Math.min(1, ratio)) * (slideSteps - 1));
        play("slide", "slide-" + k, false);
    }

    // Continuous controls (seek bars, colour hue, equalizer): tick whenever
    // the value crosses into another of `buckets` equal parts. One drag at a
    // time, so one shared state is enough; begin a drag with slideBegin().
    property int lastBucket: -1
    function slideBegin(ratio: real, buckets: int): void {
        lastBucket = Math.floor(Math.max(0, Math.min(0.9999, ratio)) * buckets);
    }
    function slideTo(ratio: real, buckets: int): void {
        const b = Math.floor(Math.max(0, Math.min(0.9999, ratio)) * buckets);
        if (b !== lastBucket) {
            lastBucket = b;
            slide(ratio);
        }
    }

    property int typingVariant: 0
    property real lastTyping: 0
    function typing(): void {
        const now = Date.now();
        if (!isOn("typing") || now - lastTyping < 35)
            return;
        lastTyping = now;
        typingVariant = (typingVariant + 1) % 3;
        play("typing", "typing-" + typingVariant, false);
    }

    // Notification: the app's own sound file wins (freedesktop hint
    // "sound-file"; "-" = the app asked for silence), and at most one sound
    // per 400 ms (notification floods).
    property real lastNotification: 0
    function notification(appFile: string): void {
        if (appFile === "-" || !isOn("notification") || Date.now() - lastNotification < 400)
            return;
        lastNotification = Date.now();
        if (appFile.startsWith("/"))
            exec(appFile, styleOf("notification") === "system" ? systemNotification : builtInFile(styleOf("notification"), "notification"));
        else
            play("notification", "notification", false);
    }

    // Preview from Settings: plays the event's sound even if it's off.
    function preview(event: string): void {
        const file = { open: "open", close: "close", click: "click", toggle: "toggle-on", slide: "slide-5",
                       typing: "typing-0", volume: "volume", edit: "edit-enter", snap: "snap",
                       notification: "notification" }[event];
        if (file)
            play(event, file, true);
    }

    // ---- Events the shell raises itself ---------------------------------------

    // Panels opening and closing (Alt+Tab is left out: it opens on every
    // Alt+Tab press). Settings counts as a panel here.
    property string lastPanel: ""
    Connections {
        target: ShellState
        function onOpenPanelChanged(): void {
            const p = ShellState.openPanel;
            if (p !== "" && p !== "alttab")
                root.play("open", "open", false);
            else if (p === "" && root.lastPanel !== "" && root.lastPanel !== "alttab")
                root.play("close", "close", false);
            root.lastPanel = p;
        }
        function onSettingsOpenChanged(): void {
            if (ShellState.settingsOpen)
                root.play("open", "open", false);
            else
                root.play("close", "close", false);
        }
    }

    // Output volume, from anywhere (bar, keys, other apps). Quiet for a
    // moment after startup and after the output device changes (its volume
    // "changes" to the new device's value then).
    property real volumeQuietUntil: Date.now() + 2000
    property real lastVolumeAt: 0
    Connections {
        target: Audio
        function onSinkChanged(): void {
            root.volumeQuietUntil = Date.now() + 500;
        }
        function onAvailableChanged(): void {
            root.volumeQuietUntil = Date.now() + 500;
        }
        function onVolumeChanged(): void {
            const now = Date.now();
            if (now < root.volumeQuietUntil || now - root.lastVolumeAt < 80)
                return;
            root.lastVolumeAt = now;
            root.play("volume", "volume", false);
        }
    }

    Connections {
        target: Widgets
        function onEditingChanged(): void {
            root.play("edit", Widgets.editing ? "edit-enter" : "edit-exit", false);
        }
    }

    // A drag catching a guide line or a magnet slot: only when it catches
    // (none -> one; the pin is re-set while the pointer moves inside a slot),
    // and at most one per 150 ms.
    property bool hadPin: false
    property real lastSnap: 0
    function snapped(): void {
        const now = Date.now();
        if (now - lastSnap < 150)
            return;
        lastSnap = now;
        play("snap", "snap", false);
    }
    Connections {
        target: Snap
        function onLineXChanged(): void {
            if (Snap.dragging && Snap.lineX && !Snap.pin)
                root.snapped();
        }
        function onLineYChanged(): void {
            if (Snap.dragging && Snap.lineY && !Snap.pin)
                root.snapped();
        }
        function onPinChanged(): void {
            const has = Snap.pin !== null;
            if (has && !root.hadPin && Snap.dragging)
                root.snapped();
            root.hadPin = has;
        }
        function onDraggingChanged(): void {
            if (!Snap.dragging)
                root.hadPin = false;
        }
    }
}
